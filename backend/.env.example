# backend/.env.example — 环境配置模板，复制为 .env 后填入实际值

# 应用
APP_NAME=E-Commerce RAG Knowledge Base
APP_VERSION=1.0.0
DEBUG=true

# LLM — OpenAI 兼容端点（DeepSeek / 百炼 qwen 均可）
# DeepSeek：base=https://api.deepseek.com，模型 deepseek-chat / deepseek-reasoner
# 百炼：    base=https://dashscope.aliyuncs.com/compatible-mode/v1，模型 qwen-plus
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3

# Embedding — OpenAI 兼容端点（百炼 text-embedding-v3 / 硅基流动 bge-m3 等）
# 百炼 key 在 https://bailian.console.aliyun.com 申请通用 sk- key
EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3

# 数据库
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# JWT
JWT_SECRET=change-this-to-a-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ChromaDB
CHROMA_PERSIST_DIR=./data/chromadb
CHROMA_COLLECTION_NAME=ecommerce_kb

# RAG 参数
CHUNK_SIZE=800
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.4
CHAT_HISTORY_WINDOW=10

# 检索优化（混合检索 / 重排 / 改写 / 缓存）
HYBRID_ENABLED=true
HYBRID_RRF_K=60
BM25_TOP_K=5
BM25_TOKENIZER=jieba
RERANK_ENABLED=false
RERANK_MODE=bm25
RERANK_TOP_N=10
RERANK_OUTPUT_K=5
QUERY_REWRITE_ENABLED=false
CACHE_ENABLED=false
CACHE_TTL=300
CACHE_MAX_ENTRIES=256

# 文件上传
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=txt,md,pdf,docx,csv,xlsx

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Admin 种子数据
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456
